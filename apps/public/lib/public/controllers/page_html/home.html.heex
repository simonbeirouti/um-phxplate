<%!-- Hero Section --%>
<div class="relative bg-primary text-primary-content">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-24 md:py-32">
    <div class="md:w-2/3">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Build powerful web applications with Phxplate
      </h1>
      <p class="text-xl md:text-2xl mb-8">
        Your go-to platform for secure, scalable web applications with built-in subscription management and team collaboration.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <.link navigate="/register">
          <button class="btn btn-accent w-full">Get Started</button>
        </.link>
        <.link navigate="/about">
          <button class="btn btn-accent w-full">Learn More</button>
        </.link>
      </div>
    </div>
  </div>
  <div
    class="absolute bottom-0 w-full h-16 bg-base-100"
    style="clip-path: polygon(0 100%, 100% 0, 100% 100%);"
  >
  </div>
</div>

<%!-- Features Section --%>
<div class="py-16 bg-base-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-base-content mb-4">
        Powerful Features for Everyone
      </h2>
      <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
        Our platform offers specialized tools and capabilities for different types of users.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Basic Users --%>
      <div class="card bg-base-200 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-user" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">Basic Users</h3>
          <ul class="text-base-content/70 space-y-2">
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Create personal profile
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Bookmark companies
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Join companies as employee
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Upgrade to admin status
            </li>
          </ul>
        </div>
      </div>
      
<!-- Admin Users -->
      <div class="card bg-base-200 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-shield-check" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">Admin Users</h3>
          <ul class="text-base-content/70 space-y-2">
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Create and manage companies
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Manage company details
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Invite and remove employees
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Access premium features
            </li>
          </ul>
        </div>
      </div>

      <%!-- Super Admin --%>
      <div class="card bg-base-200 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-cog-6-tooth" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">Super Admin</h3>
          <ul class="text-base-content/70 space-y-2">
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Unlimited company creation
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Delete any user or company
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Modify subscription status
            </li>
            <li class="flex items-start">
              <.icon name="hero-check" class="h-5 w-5 text-success mr-2 mt-0.5" />
              Complete platform access
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%!-- How It Works Section --%>
<div class="py-16 bg-base-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-base-content mb-4">How It Works</h2>
      <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
        Get your project from idea to launch in three simple steps.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Step 1 --%>
      <div class="card bg-base-100 shadow-sm transition duration-300">
        <div class="card-body text-center">
          <div class="rounded-full bg-primary w-12 h-12 flex items-center justify-center mx-auto my-4 text-primary-content font-bold">
            1
          </div>
          <h3 class="card-title text-xl text-base-content mb-2 justify-center">Purchase Access</h3>
          <p class="text-base-content/70">
            Choose a subscription plan that matches your project needs and budget. Start small and scale up as you grow.
          </p>
        </div>
      </div>

      <%!-- Step 2 --%>
      <div class="card bg-base-100 shadow-sm transition duration-300">
        <div class="card-body text-center">
          <div class="rounded-full bg-primary w-12 h-12 flex items-center justify-center mx-auto my-4 text-primary-content font-bold">
            2
          </div>
          <h3 class="card-title text-xl text-base-content mb-2 justify-center">
            Build Your Perfect Idea
          </h3>
          <p class="text-base-content/70">
            Create companies, invite team members, and use our robust tools to bring your vision to life.
          </p>
        </div>
      </div>

      <%!-- Step 3 --%>
      <div class="card bg-base-100 shadow-sm transition duration-300">
        <div class="card-body text-center">
          <div class="rounded-full bg-primary w-12 h-12 flex items-center justify-center mx-auto my-4 text-primary-content font-bold">
            3
          </div>
          <h3 class="card-title text-xl text-base-content mb-2 justify-center">Launch to the World</h3>
          <p class="text-base-content/70">
            Deploy your completed project with confidence, backed by our secure and scalable infrastructure.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%!-- Use Cases Section --%>
<div class="py-16 bg-base-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-base-content mb-4">Use Cases</h2>
      <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
        Our platform is versatile enough to power a wide range of applications.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Enterprise --%>
      <div class="card bg-base-200 border border-base-300 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-building-office" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">Enterprise Solutions</h3>
          <p class="text-base-content/70 mb-4">
            Build internal tools, team collaboration platforms, and workflow management systems for your organization.
          </p>
        </div>
      </div>

      <%!-- Social Apps --%>
      <div class="card bg-base-200 border border-base-300 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-chat-bubble-left-right" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">Social Applications</h3>
          <p class="text-base-content/70 mb-4">
            Create community platforms, forums, and social networks with user management and content moderation.
          </p>
        </div>
      </div>

      <%!-- SaaS Products --%>
      <div class="card bg-base-200 border border-base-300 shadow-sm transition duration-300">
        <div class="card-body">
          <div class="rounded-full bg-base-300 w-12 h-12 flex items-center justify-center my-4">
            <.icon name="hero-currency-dollar" class="h-6 w-6 text-base-content" />
          </div>
          <h3 class="card-title text-xl text-base-content mb-2">SaaS Products</h3>
          <p class="text-base-content/70 mb-4">
            Launch subscription-based services with built-in billing, user management, and analytics capabilities.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%!-- CTA Section --%>
<.cta />
